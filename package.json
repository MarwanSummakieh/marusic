{
  "name": "marusic",
  "version": "1.1.0",
  "description": "Spotify-style web player for YouTube Music (youtubei.js + yt-dlp), ported from involvex/youtube-music-cli",
  "type": "module",
  "main": "server.js",
  "scripts": {
    "start": "node --experimental-sqlite server.js",
    "dev": "node --experimental-sqlite --watch server.js",
    "test": "node --experimental-sqlite --test \"tests/**/*.test.js\""
  },
  "engines": {
    "node": ">=22.5.0"
  },
  "dependencies": {
    "express": "^4.21.2",
    "ffmpeg-static": "^5.3.0",
    "youtubei.js": "^17.2.0"
  }
}
