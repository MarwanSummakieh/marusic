# Copy to .env and fill in. NEVER commit the real .env (it's gitignored).

# First-run admin (seeded once, on an empty database).
ADMIN_EMAIL=you@example.com
ADMIN_PASSWORD=change-me

# Cloudflare tunnel token (used by docker-compose.yml only — the app itself
# never sees it). Zero Trust dashboard → Networks → Tunnels → your tunnel →
# the long token from the "install connector" command.
TUNNEL_TOKEN=

# ---- optional overrides ----
# NODE_ENV=production   # refuses default/missing secrets, Secure cookies
# PORT=3000
# SESSION_MAX_AGE_DAYS=30
# MIN_PASSWORD_LENGTH=8
# COOKIE_SECURE=true
# TRUST_PROXY=1         # behind a reverse proxy / tunnel
# DB_PATH=              # defaults to data/marusic.sqlite
# YTDLP_PATH=           # full path to yt-dlp if it's not on PATH
# CAST_BASE_URL=        # URL a playback device (Chromecast/Sonos/TV) fetches
#                       # streams from when the app is opened on localhost, e.g.
#                       # http://192.168.1.20:3000 — set it if the auto-picked
#                       # LAN adapter is a VPN/virtual one
# UPNP_IPS=             # comma-separated IPs of Sonos speakers or DLNA TVs, for
#                       # networks where SSDP multicast discovery can't reach
#                       # them (docker bridge, VLANs), e.g. 192.168.1.50,192.168.1.51
#                       # (SONOS_IPS is the old name and still works)

# Free lossless FLAC download sources — no account or API key. Two independent
# source families are searched by artist+title and the best match wins; when
# none are reachable, downloads fall back to the yt-dlp (YouTube) source.
#
# Qobuz — the public squid.wtf / MusicFLAC "get-music/download-music" API.
# Comma-separated, tried in order.
# LOSSLESS_API_BASE=https://qobuz.squid.wtf,https://eu.qobuz.squid.wtf
#
# Tidal — SpotiFLAC's hifi-api mirrors (github.com/binimum/hifi-api),
# comma-separated, queried in parallel. A built-in public mirror pool is used
# if unset; self-host an instance for guaranteed availability.
# TIDAL_API_BASE=https://your-hifi-api.example.com
